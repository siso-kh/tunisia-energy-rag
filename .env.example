# Copy this file to `.env` and fill in your values.
# `.env` is gitignored and never committed.

# ===== RAG / LLM API (src/rag/retrieve.py, src/utils/triage.py, src/test_rag.py) =====
# OpenAI-compatible endpoint credentials used for answer generation and triage.
CUSTOM_API_KEY=sk-...
OPENAI_BASE_URL=https://api.example.com/v1

# ===== Data Collection (src/ingestion/collector.py) =====
# SerpApi key for the primary search engine in the hybrid PDF collector.
SERPAPI_KEY=your_serpapi_key_here

# ===== Frontend (src/ui/ui.py) =====
# Backend URL the Streamlit UI calls. In docker-compose this is set to http://backend:8000/api/chat.
API_URL=http://127.0.0.1:8000/api/chat

# ===== Database (src/database/connection.py) =====
# Async SQLAlchemy connection string (asyncpg driver). Used for users, conversations,
# messages and the crowdsourced outage map. Defaults to local Postgres if unset.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/energie_tunisie

# ===== Infrastructure (docker-compose.yml) =====
# Ngrok authtoken for the public tunnel service. Get it at https://dashboard.ngrok.com
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
