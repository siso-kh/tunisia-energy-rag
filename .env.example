# Copy this file to `.env` and fill in your values.
# `.env` is gitignored and never committed.

# ===== RAG / LLM API (src/rag/retrieve.py, src/utils/triage.py, src/test_rag.py) =====
# OpenAI-compatible endpoint credentials used for answer generation and triage.
CUSTOM_API_KEY=sk-...
OPENAI_BASE_URL=https://api.example.com/v1

# ===== Data Collection (src/ingestion/collector.py) =====
# SerpApi key for the primary search engine in the hybrid PDF collector.
SERPAPI_KEY=your_serpapi_key_here

# ===== Frontend (src/ui/ui.py) =====
# Backend URL the Streamlit UI calls. In docker-compose this is set to http://backend:8000/api/chat.
API_URL=http://127.0.0.1:8000/api/chat

# ===== Database (src/database/connection.py) =====
# Async SQLAlchemy connection string (asyncpg driver). Used for users, conversations,
# messages and the crowdsourced outage map. Defaults to local Postgres if unset.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/energie_tunisie

# ===== User authentication (src/utils/security.py, src/api/auth.py) =====
# JWT signing key for user accounts (register/login). Required for the auth
# endpoints; when unset they refuse to run (HTTP 503). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime in minutes (default 10080 = 7 days).
JWT_EXPIRE_MINUTES=10080

# ===== Admin (src/api/main.py) =====
# API key protecting the /api/admin/* endpoints (purge stats + manual purge).
# The frontend Admin tab asks for this key before showing purge controls.
# When unset, admin endpoints refuse to run (HTTP 503).
ADMIN_API_KEY=change-me-to-a-long-random-string

# ===== Rate limiting (src/api/ratelimit.py) =====
# Per-client limits (slowapi syntax: <count>/<period>). The chat limits are
# the main LLM-cost guard; auth limits blunt brute force; outage limits curb
# report spam. Defaults shown below.
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_CHAT=10/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_OUTAGE_CREATE=10/minute
RATE_LIMIT_ADMIN=30/minute
# Storage backend: "memory://" for dev/single-instance, a Redis URL in prod
# (e.g. redis://redis:6379) so limits are shared across instances.
RATE_LIMIT_STORAGE_URI=memory://
# Set "false" to disable all checks (tests/CI).
RATE_LIMIT_ENABLED=true
# Set "true" only behind a trusted proxy (nginx/ngrok sets X-Forwarded-For).
TRUST_PROXY_HEADERS=false

# ===== Security (src/api/security.py) =====
# Comma-separated list of allowed browser origins for CORS (default "*" in dev).
# In production set it to your real domain, e.g. https://app.example.com
CORS_ORIGINS=*
# Opt-in hardening: HSTS only makes sense behind HTTPS; CSP is opt-in so a
# policy can be tuned without breaking Leaflet tiles / fonts.
# SECURE_HSTS=true
# SECURITY_CSP=default-src 'self'; img-src 'self' data: *.tile.openstreetmap.org

# ===== Infrastructure (docker-compose.yml) =====
# Ngrok authtoken for the public tunnel service. Get it at https://dashboard.ngrok.com
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
