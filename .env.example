# ===========================================================
# Tunisia Energy RAG — Environment Variables
# ===========================================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# NEVER commit .env to version control!
# ===========================================================

# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver)
# In Docker, use: postgresql+asyncpg://postgres:postgres@postgres:5432/energie_tunisie
# Locally, use:   postgresql+asyncpg://postgres:postgres@localhost:5432/energie_tunisie
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/energie_tunisie

# ── LLM API ──────────────────────────────────────────────
# Your Mistral/OpenAI-compatible API key (required)
CUSTOM_API_KEY=your_api_key_here

# Base URL for the LLM API (only change if using a custom provider)
# OPENAI_BASE_URL=https://api.mistral.ai/v1

# ── Authentication ────────────────────────────────────────
# JWT secret for signing user session tokens (required for auth)
JWT_SECRET=your_jwt_secret_here

# Admin API key for /api/admin/* endpoints (required for admin features)
ADMIN_API_KEY=your_admin_api_key_here

# ── Rate Limiting ─────────────────────────────────────────
# Format: N/minute or N/hour (slowapi syntax)
RATE_LIMIT_CHAT=10/minute
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_AUTH=10/minute

# Storage backend for rate limit counters
# "memory://" = in-process (default, fine for single instance)
# "redis://..." = shared across instances
RATE_LIMIT_STORAGE_URI=memory://

# ── Security ──────────────────────────────────────────────
# Trust X-Forwarded-For headers from reverse proxies
# Set to "false" if behind nginx/cloudflare to prevent IP spoofing (L14 fix)
# Set to "true" ONLY if you have a trusted proxy that strips client IPs
TRUST_PROXY_HEADERS=false

# CORS origins (comma-separated, or * for development)
CORS_ORIGINS=*

# ── Outage Reports ────────────────────────────────────────
# TTL in hours before crowd-sourced outage reports are auto-purged
OUTAGE_TTL_HOURS=5

# How often (in minutes) the purge task runs
OUTAGE_PURGE_INTERVAL_MINUTES=30

# ── Ngrok (optional) ──────────────────────────────────────
# Uncomment and set to expose the app via a public ngrok tunnel
# NGROK_AUTHTOKEN=your_ngrok_token_here

# ── Monitoring (optional) ─────────────────────────────────
# Prometheus backup interval (hours) — used by pg-backup service
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_DAYS=7
