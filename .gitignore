# ===== Project ignores =====

# Virtual environments
venv/
.venv/
env/
ENV/

# Python cache & bytecode
__pycache__/
*.py[cod]

# Environment variables & secrets
# Keep a .env.example in repo, but ignore real .env files
.env

# IDE/editor settings
.vscode/
.idea/

# ===== Data & DB artifacts (ignore generated/large files) =====

# Raw and processed document stores
data/raw/
data/filtered/
data/blacklisted/
data/processed/

# Local vector DB and related artifacts
data/chroma_db/
vector_db/
*.sqlite3

# External tools / large binaries
poppler/
kaggle/

# ===== Test / logs / misc =====
test_results.json
*.log
.pytest_cache/

.claude
.agents

# Local dev SQLite databases
*.db

# AI Agent Configurations and Logs
.ai_instructions/
ai_activity.log

# Reference design material (not part of the app)
ater-dashboard/
ater-dashboard.zip

# Database backups (generated by the pg-backup service / scripts)
backups/

# ===== LaTeX build artifacts =====
*.aux
*.toc
*.lof
*.lot
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.nav
*.snm
*.vrb

# Compiled PDFs (keep only the final one)
rapport_stage_v2.pdf
rapport_stage_final.pdf
rapport_rest.pdf

# Lock files
skills-lock.json

# Node modules
node_modules/

# Build output
frontend/dist/

# ONNX query embedder (fetched at image build time by
# scripts/fetch_onnx_embedder.py, ~235 MB). Never commit the weights.
models/
